pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    environment {
        AWS_PROFILE        = 'nextgen-jenkins'
        AWS_DEFAULT_REGION = 'us-east-2'
        AWS_REGION         = 'us-east-2'

        CLUSTER_NAME       = 'nextgen-discover-eks'
        OBS_NAMESPACE      = 'observability'

        OPENSEARCH_RELEASE = 'nextgen-jaeger'
        OPENSEARCH_VERSION = '3.10.0'

        JAEGER_RELEASE     = 'jaeger'
        JAEGER_VERSION     = '4.20.0'

        PROMETHEUS_RELEASE = 'kube-prometheus-stack'
        PROMETHEUS_VERSION = '93.10.1'

        LOKI_RELEASE       = 'loki'
        LOKI_VERSION       = '21.6.0'
        ALLOY_RELEASE      = 'alloy'
        ALLOY_VERSION      = '1.16.0'

        TF_ROOT            = 'infrastructure/terraform/infrastructure'
        TF_STATE_BUCKET    = 'nextgen-discover-terraform-state-659071697866-us-east-2'
        TF_STATE_KEY       = 'infrastructure/terraform.tfstate'
        LOKI_BUCKET_FILE   = "${WORKSPACE}/loki-bucket-name"

        OPENSEARCH_VALUES = 'infrastructure/kubernetes/observability/opensearch/values.yaml'
        JAEGER_VALUES     = 'infrastructure/kubernetes/observability/jaeger/values.yaml'
        PROMETHEUS_VALUES = 'infrastructure/kubernetes/observability/prometheus/values.yaml'
        LOKI_VALUES       = 'infrastructure/kubernetes/observability/loki/values.yaml'
        ALLOY_VALUES      = 'infrastructure/kubernetes/observability/alloy/values.yaml'
        GRAFANA_LOKI_DATASOURCE = 'infrastructure/kubernetes/observability/grafana/loki-datasource.yaml'
        SNS_TOPIC_NAME     = 'nextgen-discover-alerts'
        SNS_RENDERED_VALUES = "${WORKSPACE}/prometheus-values-rendered.yaml"

        CHART_DIR         = "${WORKSPACE}/.helm"
        KUBECONFIG        = "${WORKSPACE}/.kube/config"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    set -eu
                    echo "===== SOURCE CHECKOUT ====="
                    git rev-parse --short HEAD
                    git branch --show-current
                '''
            }
        }

        stage('Environment Checks') {
            steps {
                sh '''
                    set -eu

                    echo "===== TOOL VERSIONS ====="
                    aws --version
                    kubectl version --client
                    helm version --short
                    terraform version

                    echo "===== REQUIRED CONFIGURATION ====="
                    test -f "$OPENSEARCH_VALUES"
                    test -f "$JAEGER_VALUES"
                    test -f "$PROMETHEUS_VALUES"
                    test -f "$LOKI_VALUES"
                    test -f "$ALLOY_VALUES"
                    test -f "$GRAFANA_LOKI_DATASOURCE"

                    echo "SUCCESS: Required tools and values files exist."
                '''
            }
        }

        stage('AWS Authentication') {
            steps {
                sh '''
                    set -eu

                    echo "===== AWS IDENTITY ====="
                    aws sts get-caller-identity

                    CLUSTER_STATUS=$(aws eks describe-cluster \
                        --name "$CLUSTER_NAME" \
                        --region "$AWS_REGION" \
                        --query "cluster.status" \
                        --output text)

                    echo "EKS status: $CLUSTER_STATUS"

                    if [ "$CLUSTER_STATUS" != "ACTIVE" ]; then
                        echo "ERROR: EKS cluster is not ACTIVE."
                        exit 1
                    fi
                '''
            }
        }

        stage('Configure EKS Access') {
            steps {
                sh '''
                    set -eu

                    mkdir -p "$(dirname "$KUBECONFIG")"

                    aws eks update-kubeconfig \
                        --name "$CLUSTER_NAME" \
                        --region "$AWS_REGION" \
                        --alias nextgen-discover \
                        --kubeconfig "$KUBECONFIG"

                    echo "===== KUBERNETES ACCESS ====="
                    kubectl get nodes

                    kubectl get namespace "$OBS_NAMESPACE"

                    kubectl auth can-i create secrets \
                        --namespace "$OBS_NAMESPACE"

                    kubectl auth can-i create statefulsets \
                        --namespace "$OBS_NAMESPACE"

                    kubectl auth can-i create deployments \
                        --namespace "$OBS_NAMESPACE"


                    echo "SUCCESS: EKS access verified."
                '''
            }
        }

        stage('Configure Observability Pod Security') {
            steps {
                sh '''
                    set -eu

                    kubectl label namespace "$OBS_NAMESPACE" \
                        pod-security.kubernetes.io/enforce=privileged \
                        --overwrite

                    echo "Observability namespace Pod Security configured."
                '''
            }
        }

        stage('Resolve Loki Storage Configuration') {
            steps {
                sh '''
                    set -eu

                    echo "===== INITIALIZING TERRAFORM BACKEND ====="

                    terraform -chdir="$TF_ROOT" init \
                        -input=false \
                        -reconfigure \
                        -backend-config="bucket=$TF_STATE_BUCKET" \
                        -backend-config="key=$TF_STATE_KEY" \
                        -backend-config="region=$AWS_REGION" \
                        -backend-config="encrypt=true" \
                        -backend-config="use_lockfile=true"

                    LOKI_BUCKET_NAME=$(terraform -chdir="$TF_ROOT" output -raw loki_bucket_name)

                    if [ -z "$LOKI_BUCKET_NAME" ]; then
                        echo "ERROR: Loki bucket output is empty."
                        exit 1
                    fi

                    printf '%s' "$LOKI_BUCKET_NAME" > "$LOKI_BUCKET_FILE"

                    echo "===== VERIFYING LOKI S3 BUCKET ====="
                    aws s3api head-bucket --bucket "$LOKI_BUCKET_NAME"

                    echo "===== VERIFYING EKS POD IDENTITY ====="

                    ASSOCIATION_ID=$(aws eks list-pod-identity-associations \
                        --cluster-name "$CLUSTER_NAME" \
                        --namespace "$OBS_NAMESPACE" \
                        --service-account loki \
                        --query 'associations[0].associationId' \
                        --output text)

                    if [ -z "$ASSOCIATION_ID" ] || [ "$ASSOCIATION_ID" = "None" ]; then
                        echo "ERROR: Loki Pod Identity association not found."
                        exit 1
                    fi

                    ASSOCIATION_NAMESPACE=$(aws eks describe-pod-identity-association \
                        --cluster-name "$CLUSTER_NAME" \
                        --association-id "$ASSOCIATION_ID" \
                        --query 'association.namespace' \
                        --output text)

                    ASSOCIATION_SERVICE_ACCOUNT=$(aws eks describe-pod-identity-association \
                        --cluster-name "$CLUSTER_NAME" \
                        --association-id "$ASSOCIATION_ID" \
                        --query 'association.serviceAccount' \
                        --output text)

                    ASSOCIATION_ROLE_ARN=$(aws eks describe-pod-identity-association \
                        --cluster-name "$CLUSTER_NAME" \
                        --association-id "$ASSOCIATION_ID" \
                        --query 'association.roleArn' \
                        --output text)

                    if [ "$ASSOCIATION_NAMESPACE" != "$OBS_NAMESPACE" ] ||
                       [ "$ASSOCIATION_SERVICE_ACCOUNT" != "loki" ] ||
                       [ -z "$ASSOCIATION_ROLE_ARN" ] ||
                       [ "$ASSOCIATION_ROLE_ARN" = "None" ]; then
                        echo "ERROR: Loki Pod Identity association details are invalid."
                        exit 1
                    fi

                    echo "SUCCESS: Loki Pod Identity association verified."

                    echo "SUCCESS: Loki storage prerequisites verified."
                '''
            }
        }

        stage('Prepare Helm Charts') {
            steps {
                sh '''
                    set -eu

                    echo "===== CONFIGURING HELM REPOSITORIES ====="

                    helm repo add opensearch \
                        https://opensearch-project.github.io/helm-charts/ \
                        --force-update

                    helm repo add jaegertracing \
                        https://jaegertracing.github.io/helm-charts \
                        --force-update

                    helm repo add prometheus-community \
                        https://prometheus-community.github.io/helm-charts \
                        --force-update

                    helm repo add grafana-community \
                        https://grafana-community.github.io/helm-charts \
                        --force-update

                    helm repo add grafana \
                        https://grafana.github.io/helm-charts \
                        --force-update

                    helm repo update

                    echo "===== PREPARING SNS ALERTMANAGER CONFIGURATION ====="

                    AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                        --query Account \
                        --output text)

                    SNS_TOPIC_ARN="arn:aws:sns:${AWS_REGION}:${AWS_ACCOUNT_ID}:${SNS_TOPIC_NAME}"

                    aws sns get-topic-attributes \
                        --topic-arn "$SNS_TOPIC_ARN" > /dev/null

                    if ! grep -q '__SNS_TOPIC_ARN__' "$PROMETHEUS_VALUES"; then
                        echo "ERROR: SNS topic ARN placeholder is missing from Prometheus values."
                        exit 1
                    fi

                    sed "s|__SNS_TOPIC_ARN__|${SNS_TOPIC_ARN}|g" \
                        "$PROMETHEUS_VALUES" > "$SNS_RENDERED_VALUES"

                    if grep -q '__SNS_TOPIC_ARN__' "$SNS_RENDERED_VALUES"; then
                        echo "ERROR: SNS topic ARN placeholder was not replaced."
                        exit 1
                    fi

                    echo "SUCCESS: SNS topic verified and temporary Helm values rendered."

                    echo "===== DOWNLOADING PINNED CHARTS ====="

                    rm -rf "$CHART_DIR"
                    mkdir -p "$CHART_DIR"

                    helm pull opensearch/opensearch \
                        --version "$OPENSEARCH_VERSION" \
                        --untar \
                        --untardir "$CHART_DIR"

                    helm pull jaegertracing/jaeger \
                        --version "$JAEGER_VERSION" \
                        --untar \
                        --untardir "$CHART_DIR"

                    helm pull prometheus-community/kube-prometheus-stack \
                        --version "$PROMETHEUS_VERSION" \
                        --untar \
                        --untardir "$CHART_DIR"

                    helm pull grafana-community/loki \
                        --version "$LOKI_VERSION" \
                        --untar \
                        --untardir "$CHART_DIR"

                    helm pull grafana/alloy \
                        --version "$ALLOY_VERSION" \
                        --untar \
                        --untardir "$CHART_DIR"

                    LOKI_BUCKET_NAME=$(cat "$LOKI_BUCKET_FILE")

                    sed "s|__LOKI_BUCKET_NAME__|$LOKI_BUCKET_NAME|g" \
                        "$LOKI_VALUES" > "$CHART_DIR/loki-values-resolved.yaml"

                    if grep -q '__LOKI_BUCKET_NAME__' "$CHART_DIR/loki-values-resolved.yaml"; then
                        echo "ERROR: Loki bucket placeholder was not replaced."
                        exit 1
                    fi

                    echo "===== HELM LINT ====="

                    helm lint "$CHART_DIR/opensearch" \
                        --values "$OPENSEARCH_VALUES"

                    helm lint "$CHART_DIR/jaeger" \
                        --values "$JAEGER_VALUES"

                    helm lint "$CHART_DIR/kube-prometheus-stack" \
                        --values "$SNS_RENDERED_VALUES"

                    helm lint "$CHART_DIR/loki" \
                        --values "$CHART_DIR/loki-values-resolved.yaml"

                    helm lint "$CHART_DIR/alloy" \
                        --values "$ALLOY_VALUES"

                    echo "===== HELM TEMPLATE VALIDATION ====="

                    helm template "$OPENSEARCH_RELEASE" \
                        "$CHART_DIR/opensearch" \
                        --namespace "$OBS_NAMESPACE" \
                        --values "$OPENSEARCH_VALUES" \
                        > "$WORKSPACE/opensearch-rendered.yaml"

                    helm template "$JAEGER_RELEASE" \
                        "$CHART_DIR/jaeger" \
                        --namespace "$OBS_NAMESPACE" \
                        --values "$JAEGER_VALUES" \
                        > "$WORKSPACE/jaeger-rendered.yaml"

                    helm template "$PROMETHEUS_RELEASE" \
                        "$CHART_DIR/kube-prometheus-stack" \
                        --namespace "$OBS_NAMESPACE" \
                        --values "$SNS_RENDERED_VALUES" \
                        > "$WORKSPACE/prometheus-rendered.yaml"

                    helm template "$LOKI_RELEASE" \
                        "$CHART_DIR/loki" \
                        --namespace "$OBS_NAMESPACE" \
                        --values "$CHART_DIR/loki-values-resolved.yaml" \
                        > "$WORKSPACE/loki-rendered.yaml"

                    helm template "$ALLOY_RELEASE" \
                        "$CHART_DIR/alloy" \
                        --namespace "$OBS_NAMESPACE" \
                        --values "$ALLOY_VALUES" \
                        > "$WORKSPACE/alloy-rendered.yaml"

                    echo "SUCCESS: All five charts validated."
                '''
            }
        }

        stage('Approval - Observability Stack') {
            steps {
                script {
                    input(
                        message: 'Approve OpenSearch, Jaeger, Prometheus, Grafana, Loki and Alloy stack deployment?',
                        ok: 'Deploy Observability Stack'
                    )
                }
            }
        }

        stage('Create OpenSearch Kubernetes Secret') {
            steps {
                script {
                    withCredentials([
                        string(
                            credentialsId: 'opensearch-admin-password',
                            variable: 'OPENSEARCH_ADMIN_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set +x
                            set -eu
                            umask 077

                            echo "===== CREATING OPENSEARCH SECRET ====="

                            SECRET_DIR=$(mktemp -d)
                            trap 'rm -rf "$SECRET_DIR"' EXIT

                            SECRET_FILE="$SECRET_DIR/opensearch-password"

                            printf '%s' "$OPENSEARCH_ADMIN_PASSWORD" \
                                > "$SECRET_FILE"

                            kubectl create secret generic opensearch-admin \
                                --namespace "$OBS_NAMESPACE" \
                                --from-file=OPENSEARCH_INITIAL_ADMIN_PASSWORD="$SECRET_FILE" \
                                --dry-run=client \
                                -o yaml | kubectl apply -f -

                            unset OPENSEARCH_ADMIN_PASSWORD

                            echo "SUCCESS: OpenSearch Kubernetes Secret configured."
                        '''
                    }
                }
            }
        }

        stage('Deploy OpenSearch') {
            steps {
                sh '''
                    set -eu

                    echo "===== DEPLOYING OPENSEARCH ====="

                    helm upgrade --install "$OPENSEARCH_RELEASE" \
                        "$CHART_DIR/opensearch" \
                        --namespace "$OBS_NAMESPACE" \
                        --values "$OPENSEARCH_VALUES" \
                        --wait \
                        --timeout 25m

                    echo "===== VERIFYING OPENSEARCH STATEFULSET ====="

                    kubectl rollout status \
                        statefulset/nextgen-jaeger-master \
                        --namespace "$OBS_NAMESPACE" \
                        --timeout=20m

                    kubectl get service nextgen-jaeger-master \
                        --namespace "$OBS_NAMESPACE"

                    echo "SUCCESS: OpenSearch deployment completed."
                '''
            }
        }

        stage('Deploy Jaeger') {
            steps {
                sh '''
                    set -eu

                    echo "===== DEPLOYING JAEGER ====="

                    helm upgrade --install "$JAEGER_RELEASE" \
                        "$CHART_DIR/jaeger" \
                        --namespace "$OBS_NAMESPACE" \
                        --values "$JAEGER_VALUES" \
                        --wait \
                        --timeout 15m

                    echo "===== VERIFYING JAEGER DEPLOYMENT ====="

                    kubectl rollout status deployment/jaeger \
                        --namespace "$OBS_NAMESPACE" \
                        --timeout=10m

                    echo "SUCCESS: Jaeger deployment completed."
                '''
            }
        }

        stage('Create Grafana Kubernetes Secret') {
            steps {
                script {
                    withCredentials([
                        string(
                            credentialsId: 'grafana-admin-password',
                            variable: 'GRAFANA_ADMIN_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set +x
                            set -eu
                            umask 077

                            echo "===== CREATING GRAFANA SECRET ====="

                            SECRET_DIR=$(mktemp -d)
                            trap 'rm -rf "$SECRET_DIR"' EXIT

                            printf '%s' "admin" > "$SECRET_DIR/admin-user"
                            printf '%s' "$GRAFANA_ADMIN_PASSWORD" > "$SECRET_DIR/admin-password"

                            kubectl create secret generic grafana-admin \
                                --namespace "$OBS_NAMESPACE" \
                                --from-file=admin-user="$SECRET_DIR/admin-user" \
                                --from-file=admin-password="$SECRET_DIR/admin-password" \
                                --dry-run=client \
                                -o yaml | kubectl apply -f -

                            unset GRAFANA_ADMIN_PASSWORD

                            echo "SUCCESS: Grafana Kubernetes Secret configured."
                        '''
                    }
                }
            }
        }

        stage('Deploy Prometheus Stack') {
            steps {
                sh '''
                    set -eu

                    echo "===== DEPLOYING PROMETHEUS STACK ====="

                    helm upgrade --install "$PROMETHEUS_RELEASE" \
                        "$CHART_DIR/kube-prometheus-stack" \
                        --namespace "$OBS_NAMESPACE" \
                        --values "$SNS_RENDERED_VALUES" \
                        --wait \
                        --timeout 25m

                    echo "SUCCESS: Prometheus stack deployment completed."
                '''
            }
        }

        stage('Configure Grafana Loki Datasource') {
            steps {
                sh '''
                    set -eu
                    kubectl apply -f "$GRAFANA_LOKI_DATASOURCE"
                    kubectl get configmap grafana-datasource-loki \
                        --namespace "$OBS_NAMESPACE"
                '''
            }
        }

        stage('Deploy Loki') {
            steps {
                sh '''
                    set -eu

                    helm upgrade --install "$LOKI_RELEASE" \
                        "$CHART_DIR/loki" \
                        --namespace "$OBS_NAMESPACE" \
                        --values "$CHART_DIR/loki-values-resolved.yaml" \
                        --wait \
                        --timeout 20m

                    kubectl get service loki-gateway \
                        --namespace "$OBS_NAMESPACE"
                '''
            }
        }

        stage('Deploy Grafana Alloy') {
            steps {
                sh '''
                    set -eu

                    helm upgrade --install "$ALLOY_RELEASE" \
                        "$CHART_DIR/alloy" \
                        --namespace "$OBS_NAMESPACE" \
                        --values "$ALLOY_VALUES" \
                        --wait \
                        --timeout 15m

                    kubectl rollout status daemonset/alloy \
                        --namespace "$OBS_NAMESPACE" \
                        --timeout=10m
                '''
            }
        }

        stage('Deployment Verification') {
            steps {
                sh '''
                    set -eu

                    echo "===== VERIFYING DEPLOYMENTS ====="

                    for deployment in $(kubectl get deployments \
                        --namespace "$OBS_NAMESPACE" \
                        -o jsonpath='{.items[*].metadata.name}'); do

                        kubectl rollout status "deployment/$deployment" \
                            --namespace "$OBS_NAMESPACE" \
                            --timeout=10m
                    done

                    echo "===== VERIFYING STATEFULSETS ====="

                    for statefulset in $(kubectl get statefulsets \
                        --namespace "$OBS_NAMESPACE" \
                        -o jsonpath='{.items[*].metadata.name}'); do

                        kubectl rollout status "statefulset/$statefulset" \
                            --namespace "$OBS_NAMESPACE" \
                            --timeout=10m
                    done

                    echo "===== VERIFYING DAEMONSETS ====="

                    for daemonset in $(kubectl get daemonsets \
                        --namespace "$OBS_NAMESPACE" \
                        -o jsonpath='{.items[*].metadata.name}'); do

                        kubectl rollout status "daemonset/$daemonset" \
                            --namespace "$OBS_NAMESPACE" \
                            --timeout=10m
                    done

                    echo "===== POD STATUS AND NODE PLACEMENT ====="
                    kubectl get pods \
                        --namespace "$OBS_NAMESPACE" \
                        -o wide

                    echo "===== PERSISTENT VOLUME CLAIMS ====="
                    kubectl get pvc \
                        --namespace "$OBS_NAMESPACE"

                    echo "===== OPENSEARCH SERVICE ====="
                    kubectl get service nextgen-jaeger-master \
                        --namespace "$OBS_NAMESPACE"

                    kubectl get service loki-gateway \
                        --namespace "$OBS_NAMESPACE"

                    kubectl get configmap grafana-datasource-loki \
                        --namespace "$OBS_NAMESPACE"

                    echo "SUCCESS: Observability deployment verification completed."
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline 3: OpenSearch, Jaeger, Prometheus, Grafana, Loki, Alloy and Alertmanager deployment completed.'
        }

        failure {
            echo 'Pipeline 3 failed. Review the failed stage and Jenkins console output.'
        }

        always {
            echo 'Observability pipeline execution finished.'
        }
    }
}
