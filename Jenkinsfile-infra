pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'GITHUB_OWNER', defaultValue: 'Surya-Dasari',
               description: 'GitHub account or organization name')
        string(name: 'GITHUB_OWNER_ID', defaultValue: '173264214',
               description: 'Immutable numeric GitHub owner ID')
        string(name: 'GITHUB_REPOSITORY', defaultValue: 'nextgen-discover',
               description: 'GitHub repository name without owner')
        string(name: 'GITHUB_REPOSITORY_ID', defaultValue: '1460145920',
               description: 'Immutable numeric GitHub repository ID')
        string(name: 'GITHUB_BRANCH', defaultValue: 'dev',
               description: 'Git branch authorized for AWS OIDC')
    }

    environment {
        AWS_PROFILE = 'nextgen-jenkins'
        AWS_DEFAULT_REGION = 'us-east-2'
        AWS_REGION = 'us-east-2'
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = '0'

        TF_VAR_github_owner          = "${params.GITHUB_OWNER}"
        TF_VAR_github_owner_id       = "${params.GITHUB_OWNER_ID}"
        TF_VAR_github_repository     = "${params.GITHUB_REPOSITORY}"
        TF_VAR_github_repository_id  = "${params.GITHUB_REPOSITORY_ID}"
        TF_VAR_github_branch         = "${params.GITHUB_BRANCH}"
        TF_VAR_additional_eks_admin_principal_arns = '["arn:aws:iam::659071697866:user/suryanarayana"]'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "===== SOURCE CHECKOUT ====="
                    git rev-parse --short HEAD
                    git status --short
                '''
            }
        }

        stage('Secret Scan - Gitleaks') {
            steps {
                sh '''
                    echo "===== GITLEAKS VERSION ====="
                    gitleaks version

                    echo "===== SECRET SCAN ====="
                    gitleaks git . \
                      --redact \
                      --exit-code 1 \
                      --no-banner
                '''
            }
        }

        stage('Environment Checks') {
            steps {
                sh '''
                    set -eu

                    echo "===== TOOL VERSIONS ====="
                    terraform version
                    aws --version
                    gitleaks version

                    echo "===== AWS IDENTITY ====="
                    aws sts get-caller-identity \
                      --query Arn \
                      --output text

                    echo "===== EKS ADMIN ACCESS CONFIGURATION ====="
                    if [ -z "${TF_VAR_additional_eks_admin_principal_arns:-}" ]; then
                        echo "ERROR: Additional EKS administrator principals are not configured."
                        exit 1
                    fi

                    echo "SUCCESS: Additional EKS administrator principals are configured."
                '''
            }
        }

        stage('Terraform Format Check') {
            steps {
                sh '''
                    terraform fmt -recursive infrastructure/terraform
                    terraform fmt -check -recursive infrastructure/terraform
                '''
            }
        }

        stage('Terraform Security Scan') {
            steps {
                sh '''
                    set -eu

                    echo "===== TERRAFORM SECURITY SCAN ====="

                    trivy config \\
                      --severity HIGH,CRITICAL \\
                      --exit-code 0 \\
                      infrastructure/terraform/infrastructure

                    echo "SUCCESS: Terraform security scan completed."
                '''
            }
        }

        stage('Terraform Backend Readiness Check') {
            steps {
                sh '''
                    set -eu

                    echo "===== CHECKING S3 TERRAFORM BACKEND ====="

                    aws s3api head-bucket \
                      --bucket nextgen-discover-terraform-state-659071697866-us-east-2

                    echo "SUCCESS: S3 backend bucket exists and is accessible."
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                dir('infrastructure/terraform/infrastructure') {
                    sh '''
                        terraform init \
                          -input=false \
                          -lockfile=readonly \
                          -backend-config="bucket=nextgen-discover-terraform-state-659071697866-us-east-2" \
                          -backend-config="key=infrastructure/terraform.tfstate" \
                          -backend-config="region=us-east-2" \
                          -backend-config="encrypt=true" \
                          -backend-config="use_lockfile=true"
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('infrastructure/terraform/infrastructure') {
                    sh '''
                        terraform validate
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('infrastructure/terraform/infrastructure') {
                    sh '''
                        set +x
                        set -eu

                        terraform plan \\
                          -input=false \\
                          -no-color \\
                          -lock-timeout=5m \\
                          -out=tfplan
                    '''
                }
            }
        }

        stage('Terraform Apply Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input(
                        message: 'Review the Terraform plan. Approve to create or modify AWS infrastructure?',
                        ok: 'Approve Terraform Apply'
                    )
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('infrastructure/terraform/infrastructure') {
                    sh """
                        set -eu

                        if [ ! -f tfplan ]; then
                            echo "ERROR: Terraform plan file not found."
                            exit 1
                        fi

                        terraform apply \
                          -input=false \
                          -no-color \
                          -lock-timeout=5m \
                          tfplan
                    """
                }
            }
        }

    }

    post {
        success {
            echo 'Pipeline completed successfully through Terraform Plan.'
        }

        failure {
            echo 'Pipeline failed. Review the failed stage and Jenkins console output.'
        }
    }
}
